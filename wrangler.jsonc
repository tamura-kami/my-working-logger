{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "my-working-logger",
	"main": "worker/index.ts",
	// 初回は公開経路を作らない。Access 設定後の有効化は README を参照。
	"workers_dev": true,
	"preview_urls": false,
	"compatibility_date": "2026-10-12",
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api",
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "my-working-logger",
			// 作成済みの本番 D1。ローカル開発では --local によりローカル DB を使用。
			"database_id": "fe4c34a5-c9bb-41a0-9791-c74973b69671",
			"migrations_dir": "migrations"
		}
	]
}
